{
  "name": "rumuze/edit",
  "description": "Control OpenCode and AI coding agents on your machine directly from Telegram with live streaming cards, interactive buttons, and security sandboxing.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "opencode",
    "telegram",
    "ai-agent",
    "developer-tools",
    "remote-control",
    "laravel",
    "rumuze",
    "coding-agent"
  ],
  "authors": [
    {
      "name": "Rumuze",
      "email": "support@rumuze.com",
      "homepage": "https://rumuze.com"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "Rumuze\\Edit\\": "src/"
    }
  },
  "bin": [
    "bin/rumuze-edit"
  ],
  "extra": {
    "laravel": {
      "providers": [
        "Rumuze\\Edit\\RumuzeEditServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
