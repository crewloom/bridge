{
  "name": "crewloom-bridge",
  "version": "2.1.0",
  "description": "Crewloom Bridge: Universal AI Agent Control Room & Omni-Channel Mediator (Telegram, Phone, Email, Remote Ops). Monitor runs, stream live logs, approve diffs, and control multi-machine ops.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "crewloom-bridge": "dist/index.js",
    "cl-bridge": "dist/index.js",
    "agentgram": "dist/index.js",
    "ag": "dist/index.js",
    "rumuze-edit": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/index.js start",
    "status": "node dist/index.js status",
    "init": "node dist/index.js init"
  },
  "keywords": [
    "agentgram",
    "telegram",
    "ai-agent",
    "opencode",
    "claude-code",
    "coding-agent",
    "developer-tools",
    "remote-control",
    "terminal",
    "live-coding",
    "devops",
    "mission-control"
  ],
  "author": "Rumuze <support@rumuze.com> (https://rumuze.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crewloom/bridge.git"
  },
  "bugs": {
    "url": "https://github.com/crewloom/bridge/issues"
  },
  "homepage": "https://github.com/crewloom/bridge#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
