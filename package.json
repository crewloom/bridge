{
  "name": "agentgram",
  "version": "1.0.0",
  "description": "Turn your Telegram into a live AI Agent Control Room. Monitor coding runs, stream real-time logs, approve/reject file diffs, and control multi-machine ops from your phone.",
  "main": "bin/agentgram.js",
  "bin": {
    "agentgram": "bin/agentgram.js",
    "ag": "bin/agentgram.js",
    "rumuze-edit": "bin/agentgram.js"
  },
  "files": [
    "bin/",
    "core/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/agentgram.js start",
    "status": "node bin/agentgram.js status",
    "init": "node bin/agentgram.js init",
    "test": "python3 -m unittest discover -s tests",
    "prepack": "rm -rf core/__pycache__ tests/__pycache__"
  },
  "keywords": [
    "agentgram",
    "telegram",
    "ai-agent",
    "opencode",
    "claude-code",
    "coding-agent",
    "developer-tools",
    "remote-control",
    "terminal",
    "live-coding",
    "devops",
    "mission-control"
  ],
  "author": "Rumuze <support@rumuze.com> (https://rumuze.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rumuze/agentgram.git"
  },
  "bugs": {
    "url": "https://github.com/rumuze/agentgram/issues"
  },
  "homepage": "https://github.com/rumuze/agentgram#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
